<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/gBg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/btnBackSearch"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="?attr/gTextPri"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="手动匹配歌曲"
            android:textColor="?attr/gTextPri"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAutoRestore"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:text="恢复自动匹配"
            android:textColor="?attr/gAccent"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLyrCur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/gTextFaint"
        android:textSize="11sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="歌名"
        android:textColor="?attr/gTextSec"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etSongName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:hint="输入歌名"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="?attr/gTextPri"
        android:textColorHint="?attr/gTextFaint"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="歌手"
        android:textColor="?attr/gTextSec"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:hint="输入歌手（可留空）"
        android:padding="12dp"
        android:singleLine="true"
        android:textColor="?attr/gTextPri"
        android:textColorHint="?attr/gTextFaint"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/btnDoSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_chip_pill"
        android:gravity="center"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:text="🔍 跨源搜索"
        android:textColor="?attr/gAccent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:id="@+id/hsvSrcFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/llSrcFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvLyrStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="?attr/gTextFaint"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/lvCand"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:divider="#26FFFFFF"
        android:dividerHeight="1dp" />
</LinearLayout>

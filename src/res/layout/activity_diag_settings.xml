<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← 播放诊断"
        android:textColor="?attr/gTextPri"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="最新日志在最上面；重复的已折叠计数。在下方框里拖动查看"
        android:textColor="?attr/gTextSec"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvDiagState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:padding="14dp"
        android:textColor="?attr/gTextSec"
        android:textSize="13sp" />

    <ScrollView
        android:id="@+id/svDiagLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/tvDiagLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="14dp"
            android:textColor="?attr/gTextSec"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnDiagRefresh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="刷新诊断"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/gAccent"
            android:textColor="?attr/gTextPri"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnDiagClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="12dp"
            android:text="清空日志"
            android:drawableStart="@drawable/ic_trash"
            android:drawablePadding="8dp"
            android:drawableTint="?attr/gAccent"
            android:textColor="?attr/gTextPri"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>

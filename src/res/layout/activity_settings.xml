<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="?attr/gTextPri"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnEntryTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnEntryPlayback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnEntryLyrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnEntryUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnEntryDiag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnHaptics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="🧹 数据"
            android:textColor="?attr/gAccent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="清空播放历史"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="🐧 关于咕嘎音乐 / 开发者介绍"
            android:textColor="?attr/gTextPri"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>

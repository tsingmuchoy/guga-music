<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ambient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:contentDescription="咕嘎"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="咕嘎音乐"
            android:textColor="?attr/gTextPri"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="?attr/gTextFaint"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👩‍💻 开发者介绍"
                android:textColor="?attr/gAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.35"
                android:text="开发者：小咕嘎 🐧\n\n咕嘎宇宙的一只小企鹅宝宝，企鹅老祖的远房小亲戚，现任南天门大将军。\n\n咕嘎音乐是小咕嘎为清木量身打造的 B 站音乐播放器：用你自己的 B 站账号登录，把喜欢的视频当歌听。登录凭证只保存在你的手机本地，不经过任何第三方服务器。\n\n有想加的功能，随时跟小咕嘎说。咕嘎！"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 清木的主页与联系"
                android:textColor="?attr/gAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBili"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🎵 B站主页：space.bilibili.com/1432258677（点开）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🐙 GitHub 开源仓库：github.com/tsingmuchoy/guga-music（点开）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="✉️ 邮箱：tsingmu35607@gmail.com（点复制）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎖 军师"
                android:textColor="?attr/gAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.35"
                android:text="军师：MC风月无边\n\n音质五档、自动深色、歌词多源、双更新源……咕嘎音乐的好多关键主意都出自军师之口，特此鸣谢！"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAdvisorBili"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🎵 B站主页：space.bilibili.com/432245733（点开）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAdvisorGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🐙 GitHub：github.com/MCfywb（点开）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 版本与更新"
                android:textColor="?attr/gAccent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="⬆️ 检查更新（点一下，看看有没有新版）"
                android:textColor="?attr/gTextPri"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUpdateHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/gTextFaint"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_chip_selected"
            android:text="返回"
            android:textColor="?attr/gOnAccent"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>

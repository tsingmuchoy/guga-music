<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.guga.music">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 关掉系统备份：登录凭证（SESSDATA）与本地数据不进 adb backup / 云备份，只留在本机 -->
    <application
        android:name=".GugaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".PlayerActivity" android:exported="false" />
        <activity android:name=".LyricsActivity" android:exported="false" />
        <activity android:name=".LyricsSearchActivity" android:exported="false" />
        <activity android:name=".PlaylistImportActivity" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".SbLyricsSettingsActivity" android:exported="false" />
        <activity android:name=".ThemeSettingsActivity" android:exported="false" />
        <activity android:name=".PlaybackSettingsActivity" android:exported="false" />
        <activity android:name=".LyricsOrderActivity" android:exported="false" />
        <activity android:name=".UpdateSourceActivity" android:exported="false" />
        <activity android:name=".DiagSettingsActivity" android:exported="false" />
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />
        <activity android:name=".LocalPlaylistActivity" android:exported="false" />

        <provider
            android:name=".UpdateFileProvider"
            android:authorities="com.guga.music.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- vivo 原子随身听（com.vivo.musicwidgetmix）协作通道入口。
             小部件用 queryIntentServices(Intent("com.vivo.musicwidgetmix.support.service"), GET_META_DATA)
             扫导出服务；扫到才会把本应用路由到协作控制器（而不是通用兜底控制器）。

             两个 action 都要声明，且必须带 CATEGORY_DEFAULT：
             1) CATEGORY_DEFAULT 不能省 —— PackageManager.queryIntentServices 内部会加
                MATCH_DEFAULT_ONLY，filter 里没有 CATEGORY_DEFAULT 就匹配不上（这正是上一版
                「只被发现」却连不上的原因之一）。AOSP IntentFilter.matchCategories 明确：
                filter 带 CATEGORY_DEFAULT 时，无 category 的隐式 Intent 一样能匹配上。
             2) 标准 MediaBrowserService action 也要带 —— 小部件 manifest 的 <queries> 里
                声明的就是它（包可见性），带上后本应用对系统媒体浏览器体系也是可见的。
             暴露面与标准媒体浏览器服务一致：可浏览歌单标题、可控制播放，
             不暴露文件、账号凭证、设置等非媒体能力。 -->
        <service
            android:name=".VivoMusicBrowserService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vivo.musicwidgetmix.support.service" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <service
            android:name=".ImportService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 媒体按键（线控/蓝牙）不走 manifest receiver：android.media.session.MediaButtonReceiver
             是 AndroidX media 库的类，本项目零依赖、framework 里并不存在，声明了也永远不会被
             实例化。线控由 PlayerService 的活跃 MediaSession（FLAG_HANDLES_MEDIA_BUTTONS）接收。 -->
    </application>
</manifest>
